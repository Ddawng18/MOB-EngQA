<?xml version="1.0" encoding="utf-8"?><!--
   Backup/transfer rules for API 31+.
   Session/private state must not leave the device: Firebase Auth keeps its session in
   SharedPreferences, Firestore keeps its offline cache in the databases directory, and queued
   question drafts contain user media and are account-specific.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="pending" />
        <exclude domain="file" path="firestore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="pending" />
        <exclude domain="file" path="firestore" />
    </device-transfer>
</data-extraction-rules>
