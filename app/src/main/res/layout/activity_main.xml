<?xml version="1.0" encoding="utf-8"?>
<!-- Interface 1: "Đặt câu hỏi" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/ask_title"
            android:textAppearance="@style/TextAppearance.EngQA.TitleLarge"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvUploadStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_orange"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/form_horizontal_padding"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/form_horizontal_padding"
            android:paddingBottom="16dp">

            <!-- Question content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/FormLabel"
                    android:text="@string/label_title" />

                <EditText
                    android:id="@+id/etTitle"
                    style="@style/FormInput"
                    android:hint="@string/hint_title"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />

                <TextView
                    style="@style/FormLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/label_description" />

                <EditText
                    android:id="@+id/etDescription"
                    style="@style/FormInput"
                    android:layout_height="132dp"
                    android:gravity="top|start"
                    android:hint="@string/hint_description"
                    android:inputType="textMultiLine|textCapSentences"
                    android:paddingTop="14dp" />

                <TextView
                    style="@style/FormLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/label_passage" />

                <EditText
                    android:id="@+id/etPassage"
                    style="@style/FormInput"
                    android:layout_height="104dp"
                    android:gravity="top|start"
                    android:hint="@string/hint_passage"
                    android:inputType="textMultiLine"
                    android:paddingTop="14dp" />
            </LinearLayout>

            <!-- Classification -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/FormLabel"
                    android:text="@string/label_type" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:background="@drawable/bg_input">

                    <Spinner
                        android:id="@+id/spinnerTag"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:dropDownVerticalOffset="52dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="40dp"
                        android:popupBackground="@color/bg_card" />

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_dropdown_arrow"
                        app:tint="@color/text_secondary" />
                </FrameLayout>

                <TextView
                    style="@style/FormLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/label_level" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:background="@drawable/bg_input">

                    <Spinner
                        android:id="@+id/spinnerLevel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:dropDownVerticalOffset="52dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="40dp"
                        android:popupBackground="@color/bg_card" />

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_dropdown_arrow"
                        app:tint="@color/text_secondary" />
                </FrameLayout>
            </LinearLayout>

            <!-- Attachments -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/FormLabel"
                    android:text="@string/label_images" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnAttachImage"
                        style="@style/OutlineButton"
                        android:layout_marginEnd="5dp"
                        android:drawableStart="@drawable/ic_image"
                        android:drawableTint="@color/text_body"
                        android:text="@string/btn_attach_image" />

                    <TextView
                        android:id="@+id/btnTakePhoto"
                        style="@style/OutlineButton"
                        android:layout_marginStart="5dp"
                        android:drawableStart="@drawable/ic_camera"
                        android:drawableTint="@color/text_body"
                        android:text="@string/btn_take_photo" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerAttachments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:scrollbars="none" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/image_note"
                    android:textAppearance="@style/TextAppearance.EngQA.LabelSmall" />

                <TextView
                    style="@style/FormLabel"
                    android:layout_marginTop="20dp"
                    android:text="@string/label_audio" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnAddAudio"
                        style="@style/OutlineButton"
                        android:layout_marginEnd="5dp"
                        android:drawableStart="@drawable/ic_audio"
                        android:drawableTint="@color/text_body"
                        android:text="@string/btn_add_audio" />

                    <TextView
                        android:id="@+id/btnRecordAudio"
                        style="@style/OutlineButton"
                        android:layout_marginStart="5dp"
                        android:drawableStart="@drawable/ic_mic"
                        android:drawableTint="@color/text_body"
                        android:text="@string/btn_record_audio" />
                </LinearLayout>

                <com.example.engqa.ui.AudioPlayerView
                    android:id="@+id/audioPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/audio_note"
                    android:textAppearance="@style/TextAppearance.EngQA.LabelSmall" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom action bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnPostQuestion"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/btn_post_question"
            android:textColor="@color/on_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height" />
</LinearLayout>
