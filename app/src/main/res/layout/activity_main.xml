<?xml version="1.0" encoding="utf-8"?>
<!-- Interface 1: "Đặt câu hỏi" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/ask_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/FormLabel"
                android:text="@string/label_title" />

            <EditText
                android:id="@+id/etTitle"
                style="@style/FormInput"
                android:layout_height="46dp"
                android:hint="@string/hint_title"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLines="1" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="16dp"
                android:text="@string/label_description" />

            <EditText
                android:id="@+id/etDescription"
                style="@style/FormInput"
                android:layout_height="138dp"
                android:gravity="top|start"
                android:hint="@string/hint_description"
                android:inputType="textMultiLine|textCapSentences"
                android:paddingTop="12dp" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="20dp"
                android:text="@string/label_images" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAttachImage"
                    style="@style/OutlineButton"
                    android:layout_marginEnd="6dp"
                    android:text="@string/btn_attach_image" />

                <TextView
                    android:id="@+id/btnTakePhoto"
                    style="@style/OutlineButton"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_take_photo" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/image_note"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="16dp"
                android:text="@string/label_tag" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_input">

                <Spinner
                    android:id="@+id/spinnerTag"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:dropDownVerticalOffset="46dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="32dp"
                    android:popupBackground="@color/bg_card" />

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_dropdown_arrow" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom action bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnPostQuestion"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/btn_post_question"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
