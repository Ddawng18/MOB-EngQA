<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/center_edit_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollCenterEdit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/form_horizontal_padding"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/form_horizontal_padding"
            android:paddingBottom="16dp">

            <TextView
                style="@style/FormLabel"
                android:text="@string/center_name" />

            <EditText
                android:id="@+id/etCenterName"
                style="@style/FormInput"
                android:layout_height="46dp"
                android:maxLines="1" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:text="@string/center_description" />

            <EditText
                android:id="@+id/etCenterDescription"
                style="@style/FormInput"
                android:layout_height="100dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:paddingTop="12dp" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:text="@string/center_address" />

            <EditText
                android:id="@+id/etCenterAddress"
                style="@style/FormInput"
                android:layout_height="46dp"
                android:maxLines="1" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:text="@string/center_phone" />

            <EditText
                android:id="@+id/etCenterPhone"
                style="@style/FormInput"
                android:layout_height="46dp"
                android:inputType="phone"
                android:maxLines="1" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:text="@string/center_email" />

            <EditText
                android:id="@+id/etCenterEmail"
                style="@style/FormInput"
                android:layout_height="46dp"
                android:inputType="textEmailAddress"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btnSaveCenter"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/save"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="@color/divider" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="16dp"
                android:text="@string/center_courses" />

            <EditText
                android:id="@+id/etCourseTitle"
                style="@style/FormInput"
                android:layout_height="46dp"
                android:hint="@string/center_name"
                android:maxLines="1" />

            <EditText
                android:id="@+id/etCourseLevel"
                style="@style/FormInput"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:hint="@string/label_level"
                android:maxLines="1" />

            <EditText
                android:id="@+id/etCourseSchedule"
                style="@style/FormInput"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:hint="@string/center_phone"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btnAddCourse"
                style="@style/OutlineButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:text="@string/center_courses" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="@color/divider" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="16dp"
                android:text="@string/center_posts" />

            <EditText
                android:id="@+id/etPostTitle"
                style="@style/FormInput"
                android:layout_height="46dp"
                android:hint="@string/label_title"
                android:maxLines="1" />

            <EditText
                android:id="@+id/etPostBody"
                style="@style/FormInput"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:gravity="top|start"
                android:hint="@string/label_description"
                android:inputType="textMultiLine"
                android:paddingTop="12dp" />

            <TextView
                android:id="@+id/btnAddPost"
                style="@style/OutlineButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:text="@string/center_posts" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
