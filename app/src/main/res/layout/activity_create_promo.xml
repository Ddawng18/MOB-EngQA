<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/createPromoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical"
    tools:context=".CreatePromoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/promo_create_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollCreatePromo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/form_horizontal_padding"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/form_horizontal_padding"
            android:paddingBottom="16dp">

            <!-- Centre banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvPromoCenterName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPromoPendingNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/promo_pending_note"
                    android:textColor="@color/accent_orange"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="16dp"
                android:text="@string/label_title" />

            <EditText
                android:id="@+id/etPromoTitle"
                style="@style/FormInput"
                android:layout_height="@dimen/input_height"
                android:hint="@string/promo_title_hint"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLines="1" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:text="@string/label_description" />

            <EditText
                android:id="@+id/etPromoBody"
                style="@style/FormInput"
                android:layout_height="120dp"
                android:gravity="top|start"
                android:hint="@string/promo_body_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:paddingTop="12dp" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:text="@string/promo_field_type" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:background="@drawable/bg_input">

                <Spinner
                    android:id="@+id/spinnerPromoType"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:dropDownVerticalOffset="52dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="32dp"
                    android:popupBackground="@color/bg_card" />

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_dropdown_arrow" />
            </FrameLayout>

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:text="@string/promo_field_level" />

            <EditText
                android:id="@+id/etPromoLevel"
                style="@style/FormInput"
                android:layout_height="@dimen/input_height"
                android:hint="@string/promo_field_level"
                android:inputType="textCapWords"
                android:maxLines="1" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:text="@string/promo_field_fee" />

            <EditText
                android:id="@+id/etPromoFee"
                style="@style/FormInput"
                android:layout_height="@dimen/input_height"
                android:hint="@string/promo_field_fee"
                android:inputType="textCapSentences"
                android:maxLines="1" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:text="@string/promo_field_schedule" />

            <EditText
                android:id="@+id/etPromoSchedule"
                style="@style/FormInput"
                android:layout_height="@dimen/input_height"
                android:hint="@string/promo_field_schedule"
                android:inputType="textCapSentences"
                android:maxLines="1" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:text="@string/promo_field_phone" />

            <EditText
                android:id="@+id/etPromoPhone"
                style="@style/FormInput"
                android:layout_height="@dimen/input_height"
                android:hint="@string/promo_field_phone"
                android:inputType="phone"
                android:maxLines="1" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:text="@string/promo_field_link" />

            <EditText
                android:id="@+id/etPromoLink"
                style="@style/FormInput"
                android:layout_height="@dimen/input_height"
                android:hint="@string/promo_field_link"
                android:inputType="textUri"
                android:maxLines="1" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:text="@string/promo_field_image" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPickPromoImage"
                    style="@style/OutlineButton"
                    android:layout_marginEnd="5dp"
                    android:drawableStart="@drawable/ic_image"
                    android:drawableTint="@color/text_body"
                    android:text="@string/promo_image_pick" />

                <TextView
                    android:id="@+id/btnRemovePromoImage"
                    style="@style/OutlineButton"
                    android:layout_marginStart="5dp"
                    android:text="@string/promo_image_remove"
                    android:textColor="@color/error_red"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPromoImageStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPromoImagePreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/promo_field_image"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.EngQA.Image" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:text="@string/promo_field_end_at" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPromoDeadline"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/input_height"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/promo_no_deadline"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnPickDate"
                    style="@style/OutlineButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginStart="8dp"
                    android:text="@string/promo_pick_date" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvFormError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:textColor="@color/error_red"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/btnSubmitPromo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/promo_submit"
            android:textColor="@color/on_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressPromo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="14dp"
            android:indeterminateTint="@android:color/white"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
