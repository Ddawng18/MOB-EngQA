<?xml version="1.0" encoding="utf-8"?>
<!-- Feed card for an approved centre promo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/promoCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_promo_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/card_padding">

    <!-- Centre row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPromoAvatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:textColor="@color/accent_orange"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPromoCenter"
            style="@style/Promo.CenterName"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/ivPromoVerified"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/promo_verified"
            android:src="@drawable/ic_verified"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPromoTime"
            style="@style/Promo.Meta"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvPromoBadge"
            style="@style/Promo.Badge"
            android:text="@string/promo_badge" />
    </LinearLayout>

    <!-- Banner (hidden when imageUrl is empty); keeps the promo image's aspect ratio. -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivPromoBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/promo_badge"
        android:minHeight="140dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.EngQA.Image" />

    <TextView
        android:id="@+id/tvPromoType"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/accent_orange"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvPromoTitle"
        style="@style/Promo.Title"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvPromoBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_body"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPromoMeta"
            style="@style/Promo.Meta"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvPromoDeal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/promo_view_deal"
            android:textColor="@color/accent_orange"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
