<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/securityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical"
    tools:context=".AccountSecurityActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/account_security_title"
            android:textAppearance="@style/TextAppearance.EngQA.TitleLarge"
            android:textSize="18sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="4dp"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="24dp">

                <!-- Sign-in method -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@string/settings_security"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/accent_orange" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/settings_security"
                            android:textAppearance="@style/TextAppearance.EngQA.Subtitle" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSecurityBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/security_checking"
                        android:textAppearance="@style/TextAppearance.EngQA.BodySmall"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvLinkedNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/security_linked_note"
                        android:textColor="@color/accent_orange"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoogleSecurity"
                        style="@style/Widget.EngQA.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="14dp"
                        android:text="@string/security_google_button"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Native password workflow -->
                <LinearLayout
                    android:id="@+id/cardPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding"
                    android:visibility="gone">

                    <TextView
                        style="@style/FormLabel"
                        android:text="@string/change_password_title" />

                    <EditText
                        android:id="@+id/etCurrentPassword"
                        style="@style/FormInput"
                        android:autofillHints="password"
                        android:hint="@string/hint_current_password"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:maxLines="1" />

                    <EditText
                        android:id="@+id/etNewPassword"
                        style="@style/FormInput"
                        android:layout_marginTop="12dp"
                        android:autofillHints="newPassword"
                        android:hint="@string/hint_new_password"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:maxLines="1" />

                    <EditText
                        android:id="@+id/etConfirmPassword"
                        style="@style/FormInput"
                        android:layout_marginTop="12dp"
                        android:autofillHints="newPassword"
                        android:hint="@string/hint_confirm_password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/tvSecurityError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/error_red"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpdatePassword"
                        style="@style/Widget.EngQA.Button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/security_save" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetEmail"
                        style="@style/Widget.EngQA.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="4dp"
                        android:text="@string/security_reset_button" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/progressSecurity"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent_orange"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
