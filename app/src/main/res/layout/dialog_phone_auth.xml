<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121417"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Tiêu đề -->
    <TextView
        android:id="@+id/tvPhoneTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đăng nhập bằng Số điện thoại"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Mô tả -->
    <TextView
        android:id="@+id/tvPhoneSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Nhập số điện thoại để nhận mã xác thực OTP"
        android:textColor="#A0A0A0"
        android:textSize="13sp" />

    <!-- EditText Số điện thoại -->
    <EditText
        android:id="@+id/edtPhoneInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_auth_input"
        android:hint="Ví dụ: 0901234567"
        android:inputType="phone"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="14sp" />

    <!-- EditText OTP -->
    <EditText
        android:id="@+id/edtOtpInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_auth_input"
        android:hint="Mã OTP 6 số"
        android:inputType="number"
        android:maxLength="6"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Text Error -->
    <TextView
        android:id="@+id/tvPhoneError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FF6B6B"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Button Hành động & ProgressBar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPhoneAction"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Gửi mã OTP"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:backgroundTint="#FF4500"
            app:cornerRadius="8dp" />

        <ProgressBar
            android:id="@+id/progressPhone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
