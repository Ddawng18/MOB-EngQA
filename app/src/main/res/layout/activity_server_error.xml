<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/serverErrorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/error_screen_bg"
    tools:context=".ServerErrorActivity">

    <!-- Top App Bar : 412x72, #1A1A1B, padding 16/14 -->
    <FrameLayout
        android:id="@+id/errorTopBar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@color/bg_topbar"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:text="@string/app_name"
            android:textColor="@color/error_appbar_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Centered error illustration + copy -->
    <LinearLayout
        android:id="@+id/errorContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/errorTopBar"
        app:layout_constraintVertical_bias="0.317">

        <ImageView
            android:id="@+id/ivNoConnection"
            android:layout_width="277dp"
            android:layout_height="277dp"
            android:contentDescription="@string/server_error_illustration"
            android:src="@drawable/img_no_connection" />

        <TextView
            android:id="@+id/tvErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/server_error_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvErrorCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/server_error_code"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
