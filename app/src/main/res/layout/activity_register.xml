<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/registerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true"
    android:paddingStart="@dimen/auth_horizontal_padding"
    android:paddingTop="24dp"
    android:paddingEnd="@dimen/auth_horizontal_padding"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Brand mark -->
        <TextView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="@dimen/auth_title_top_margin"
            android:background="@drawable/bg_logo"
            android:gravity="center"
            android:text="@string/brand_letter"
            android:textColor="@color/on_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/register_title"
            android:textAppearance="@style/TextAppearance.EngQA.Display"
            android:textSize="30sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/register_subtitle"
            android:textAppearance="@style/TextAppearance.EngQA.Caption"
            android:textSize="14sp" />

        <!-- Display name -->
        <EditText
            android:id="@+id/edtUsername"
            style="@style/FormInput"
            android:layout_height="54dp"
            android:layout_marginTop="@dimen/auth_field_top_margin"
            android:autofillHints="username"
            android:drawableStart="@drawable/ic_person"
            android:drawableTint="@color/text_hint"
            android:hint="@string/hint_username"
            android:imeOptions="actionNext"
            android:inputType="textCapWords"
            android:maxLength="24"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvUsernameHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/username_rules"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <!-- Email -->
        <EditText
            android:id="@+id/edtEmail"
            style="@style/FormInput"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:autofillHints="emailAddress"
            android:drawableStart="@drawable/ic_mail"
            android:drawableTint="@color/text_hint"
            android:hint="@string/hint_email"
            android:imeOptions="actionNext"
            android:inputType="textEmailAddress"
            android:maxLines="1" />

        <!-- Password -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/edtPassword"
                style="@style/FormInput"
                android:layout_height="match_parent"
                android:autofillHints="newPassword"
                android:drawableStart="@drawable/ic_lock"
                android:drawableTint="@color/text_hint"
                android:hint="@string/hint_password"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingEnd="48dp" />

            <ImageView
                android:id="@+id/btnTogglePassword"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/toggle_password"
                android:padding="12dp"
                android:src="@drawable/ic_visibility_off"
                app:tint="@color/text_secondary" />
        </FrameLayout>

        <!-- Confirm password -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/edtConfirmPassword"
                style="@style/FormInput"
                android:layout_height="match_parent"
                android:autofillHints="newPassword"
                android:drawableStart="@drawable/ic_lock"
                android:drawableTint="@color/text_hint"
                android:hint="@string/hint_confirm_password"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingEnd="48dp" />

            <ImageView
                android:id="@+id/btnToggleConfirmPassword"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/toggle_password"
                android:padding="12dp"
                android:src="@drawable/ic_visibility_off"
                app:tint="@color/text_secondary" />
        </FrameLayout>

        <!-- Inline error -->
        <TextView
            android:id="@+id/tvAuthError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/error_red"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Register button + progress -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                style="@style/Widget.EngQA.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_register" />

            <ProgressBar
                android:id="@+id/progressAuth"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="16dp"
                android:indeterminateTint="@color/on_primary"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="@string/or"
                android:textAppearance="@style/TextAppearance.EngQA.LabelSmall" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogle"
            style="@style/Widget.EngQA.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/btn_google"
            android:textColor="#1F1F1F"
            app:backgroundTint="#FFFFFFFF"
            app:cornerRadius="@dimen/radius_m"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@null" />

        <TextView
            android:id="@+id/tvTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/terms_text"
            android:textColor="@color/text_hint"
            android:textColorLink="@color/link_blue"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvGoLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/have_account"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
