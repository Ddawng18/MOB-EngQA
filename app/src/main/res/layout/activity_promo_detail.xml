<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/promoDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical"
    tools:context=".PromoDetailActivity">

    <!-- Top bar with Up navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/promo_detail_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnReportPromo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/report"
            android:padding="10dp"
            android:src="@drawable/ic_more"
            app:tint="@color/text_body" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollPromo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_promo_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPromoCenter"
                            style="@style/Promo.CenterName"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textSize="15sp" />

                        <ImageView
                            android:id="@+id/ivPromoVerified"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@string/promo_verified"
                            android:src="@drawable/ic_verified"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvPromoBadge"
                            style="@style/Promo.Badge"
                            android:layout_marginStart="8dp"
                            android:text="@string/promo_badge" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivPromoBanner"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/promo_banner_height"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_attachment"
                        android:contentDescription="@string/promo_badge"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvPromoType"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="@color/accent_orange"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvPromoTitle"
                        style="@style/Promo.Title"
                        android:layout_marginTop="10dp"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvPromoBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text_body"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPromoExpired"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="@string/promo_expired"
                        android:textColor="@color/promo_expired"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/divider" />

                    <!-- Info grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Promo.Meta"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/promo_field_level" />

                        <TextView
                            android:id="@+id/tvPromoLevel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_body"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Promo.Meta"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/promo_field_fee" />

                        <TextView
                            android:id="@+id/tvPromoFee"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_body"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Promo.Meta"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/promo_field_schedule" />

                        <TextView
                            android:id="@+id/tvPromoSchedule"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_body"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Promo.Meta"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/promo_field_end_at" />

                        <TextView
                            android:id="@+id/tvPromoDeadline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_body"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPromoStats"
                        style="@style/Promo.Meta"
                        android:layout_width="match_parent"
                        android:layout_marginTop="12dp" />

                    <!-- Contact buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnWebsite"
                            style="@style/OutlineButton"
                            android:layout_marginEnd="6dp"
                            android:text="@string/promo_open_website" />

                        <TextView
                            android:id="@+id/btnCall"
                            style="@style/OutlineButton"
                            android:layout_marginStart="6dp"
                            android:text="@string/promo_call_now" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnSavePromo"
                        style="@style/OutlineButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/save_promo" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPromoDisclaimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/promo_disclaimer"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.example.engqa.ui.StateView
            android:id="@+id/stateView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/btnRegisterLead"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/promo_register_lead"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
