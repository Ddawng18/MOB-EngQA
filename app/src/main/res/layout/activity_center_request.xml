<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/center_request_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollCenterRequest"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/form_horizontal_padding"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/form_horizontal_padding"
            android:paddingBottom="16dp">

            <TextView
                style="@style/FormLabel"
                android:labelFor="@id/etCenterName"
                android:text="@string/center_name" />

            <EditText
                android:id="@+id/etCenterName"
                style="@style/FormInput"
                android:layout_height="@dimen/input_height"
                android:inputType="textCapWords"
                android:maxLines="1" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:labelFor="@id/etCenterDescription"
                android:text="@string/center_description" />

            <EditText
                android:id="@+id/etCenterDescription"
                style="@style/FormInput"
                android:layout_height="110dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:paddingTop="12dp" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:labelFor="@id/etCenterAddress"
                android:text="@string/center_address" />

            <EditText
                android:id="@+id/etCenterAddress"
                style="@style/FormInput"
                android:layout_height="@dimen/input_height"
                android:inputType="textCapWords"
                android:maxLines="1" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:labelFor="@id/etCenterPhone"
                android:text="@string/center_phone" />

            <EditText
                android:id="@+id/etCenterPhone"
                style="@style/FormInput"
                android:layout_height="@dimen/input_height"
                android:inputType="phone"
                android:maxLines="1" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="14dp"
                android:labelFor="@id/etCenterEmail"
                android:text="@string/center_email" />

            <EditText
                android:id="@+id/etCenterEmail"
                style="@style/FormInput"
                android:layout_height="@dimen/input_height"
                android:inputType="textEmailAddress"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btnSubmitRequest"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/center_request_title"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
