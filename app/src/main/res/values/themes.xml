<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      The reference design is dark-only, so both day and night use the dark Material 3 theme.
      Colour roles come from colors.xml; typography comes from type.xml.
    -->
    <style name="Base.Theme.EngQA" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/accent_orange_dim</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/verified_blue</item>
        <item name="colorOnSecondary">@color/bg_screen</item>
        <item name="colorSecondaryContainer">@color/bg_attachment</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_input</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border_input</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/black</item>
        <item name="android:colorBackground">@color/bg_screen</item>
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:statusBarColor">@color/bg_screen</item>
        <item name="android:navigationBarColor">@color/bg_bottom_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.EngQA.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.EngQA.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.EngQA.Title</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.EngQA.Subtitle</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.EngQA.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.EngQA.BodySmall</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.EngQA.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.EngQA.Label</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.EngQA.LabelSmall</item>
        <item name="materialButtonStyle">@style/Widget.EngQA.Button</item>
        <item name="materialCardViewStyle">@style/Widget.EngQA.Card</item>
        <!-- Required by PreferenceFragmentCompat (Settings screen). -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <style name="Theme.EngQA" parent="Base.Theme.EngQA" />
</resources>
