<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape variant of the "Đặt câu hỏi" screen: the form splits into two columns so the user
     can see more fields at once on wide screens. All ids match the portrait layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/ask_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUploadStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textColor="@color/accent_orange"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Left column: the question text -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FormLabel"
                    android:text="@string/label_title" />

                <EditText
                    android:id="@+id/etTitle"
                    style="@style/FormInput"
                    android:layout_height="46dp"
                    android:hint="@string/hint_title"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />

                <TextView
                    style="@style/FormLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_description" />

                <EditText
                    android:id="@+id/etDescription"
                    style="@style/FormInput"
                    android:layout_height="120dp"
                    android:gravity="top|start"
                    android:hint="@string/hint_description"
                    android:inputType="textMultiLine|textCapSentences"
                    android:paddingTop="12dp" />

                <TextView
                    style="@style/FormLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_passage" />

                <EditText
                    android:id="@+id/etPassage"
                    style="@style/FormInput"
                    android:layout_height="90dp"
                    android:gravity="top|start"
                    android:hint="@string/hint_passage"
                    android:inputType="textMultiLine"
                    android:paddingTop="12dp" />
            </LinearLayout>

            <!-- Right column: metadata and media -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FormLabel"
                    android:text="@string/label_type" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input">

                    <Spinner
                        android:id="@+id/spinnerTag"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:dropDownVerticalOffset="46dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="32dp"
                        android:popupBackground="@color/bg_card" />

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_dropdown_arrow" />
                </FrameLayout>

                <TextView
                    style="@style/FormLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_level" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input">

                    <Spinner
                        android:id="@+id/spinnerLevel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:dropDownVerticalOffset="46dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="32dp"
                        android:popupBackground="@color/bg_card" />

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_dropdown_arrow" />
                </FrameLayout>

                <TextView
                    style="@style/FormLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_images" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnAttachImage"
                        style="@style/OutlineButton"
                        android:layout_marginEnd="4dp"
                        android:text="@string/btn_attach_image" />

                    <TextView
                        android:id="@+id/btnTakePhoto"
                        style="@style/OutlineButton"
                        android:layout_marginStart="4dp"
                        android:text="@string/btn_take_photo" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerAttachments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:scrollbars="none" />

                <TextView
                    style="@style/FormLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_audio" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnAddAudio"
                        style="@style/OutlineButton"
                        android:layout_marginEnd="4dp"
                        android:text="@string/btn_add_audio" />

                    <TextView
                        android:id="@+id/btnRecordAudio"
                        style="@style/OutlineButton"
                        android:layout_marginStart="4dp"
                        android:text="@string/btn_record_audio" />
                </LinearLayout>

                <com.example.engqa.ui.AudioPlayerView
                    android:id="@+id/audioPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnPostQuestion"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/btn_post_question"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="60dp" />
</LinearLayout>
