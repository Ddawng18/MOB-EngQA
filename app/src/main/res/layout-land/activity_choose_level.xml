<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: level cards become a compact horizontal row so the action stays on screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/choose_level_title"
        android:textAppearance="@style/TextAppearance.EngQA.Headline"
        android:textSize="22sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="@string/choose_level_subtitle"
        android:textAppearance="@style/TextAppearance.EngQA.Caption" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="top"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBeginner"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_level_card"
            android:gravity="start|center_vertical"
            android:minHeight="100dp"
            android:padding="14dp"
            android:textAllCaps="false" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnIntermediate"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_level_card"
            android:gravity="start|center_vertical"
            android:minHeight="100dp"
            android:padding="14dp"
            android:textAllCaps="false" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAdvance"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_level_card"
            android:gravity="start|center_vertical"
            android:minHeight="100dp"
            android:padding="14dp"
            android:textAllCaps="false" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_button_primary"
        android:drawableEnd="@drawable/ic_arrow_right"
        android:drawableTint="@color/on_primary"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/btn_continue"
        android:textAllCaps="false"
        android:textColor="@color/on_primary"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
