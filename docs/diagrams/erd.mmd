erDiagram
    USERS ||--o{ QUESTIONS : writes
    USERS ||--o{ ANSWERS : writes
    USERS ||--o{ NOTIFICATIONS : receives
    USERS ||--o{ REPORTS : creates
    USERS ||--o{ SAVED_PROMO : saves
    QUESTIONS ||--o{ ANSWERS : has
    ANSWERS ||--o{ VOTES : has
    QUESTIONS ||--o{ MEDIA : contains
    CENTERS ||--o{ COURSES : offers
    CENTERS ||--o{ CENTER_POSTS : publishes
    CENTERS ||--o{ PROMOS : promotes
    PROMOS ||--o{ LEADS : receives
    REPORTS }o--|| QUESTIONS : targets
    REPORTS }o--|| PROMOS : targets

    USERS {
      string uid PK
      string email
      string username
      string role
      string status
      timestamp timeoutUntil
      int warningCount
      int questionCount
      int answerCount
    }
    QUESTIONS {
      string id PK
      string authorId FK
      string title
      string body
      string categoryId
      int score
      int answerCount
      bool isSolved
      string acceptedAnswerId
      timestamp createdAt
    }
    ANSWERS {
      string id PK
      string authorId FK
      string body
      int upCount
      int downCount
      bool isAccepted
      timestamp createdAt
    }
    VOTES {
      string voterId PK
      int value
    }
    NOTIFICATIONS {
      string id PK
      string recipientId FK
      string actorId FK
      string type
      bool read
      timestamp createdAt
    }
    CENTERS {
      string id PK
      string ownerUid FK
      array managerUids
      string status
      bool verified
    }
    PROMOS {
      string id PK
      string authorUid FK
      string centerId FK
      string status
      timestamp endAt
      int viewCount
      int leadCount
    }
    REPORTS {
      string id PK
      string reporterId FK
      string targetPath
      string status
      string resolutionAction
      timestamp createdAt
    }
