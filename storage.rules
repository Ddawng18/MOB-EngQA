rules_version = '2';

// EngQA Cloud Storage rules.
//
// Layout: questions/{uid}/{qid}/images/... and questions/{uid}/{qid}/audio/...
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
          && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isCenterManager(centerId) {
      return request.auth != null
          && firestore.exists(/databases/(default)/documents/centers/$(centerId))
          && request.auth.uid in firestore.get(
              /databases/(default)/documents/centers/$(centerId)).data.managerUids
          && firestore.get(
              /databases/(default)/documents/centers/$(centerId)).data.status == 'APPROVED';
    }

    match /questions/{uid}/{questionId}/{media}/{fileName} {
      allow read: if true;

      // Images: JPG/PNG up to 5 MB, uploaded only by their owner.
      allow write: if request.auth != null
          && request.auth.uid == uid
          && media == 'images'
          && request.resource.size <= 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|jpg|png)');

      // Audio: up to 10 MB, uploaded only by their owner.
      allow write: if request.auth != null
          && request.auth.uid == uid
          && media == 'audio'
          && request.resource.size <= 10 * 1024 * 1024
          && request.resource.contentType.matches('audio/.*');
    }

    // Centre logos (optional). Only an admin or an approved manager of that centre may write;
    // previously any signed-in account could overwrite any centre's logo.
    match /centers/{centerId}/{fileName} {
      allow read: if true;
      allow write: if (isAdmin() || isCenterManager(centerId))
          && request.resource.size <= 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
          && request.auth.uid == uid
          && request.resource.size <= 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }
  }
}
