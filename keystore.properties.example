# Copy this file to `keystore.properties` (same folder) and fill in your own values.
# `keystore.properties` is git-ignored and must never be committed.
#
# Create the keystore once with:
#   keytool -genkeypair -v -keystore C:/Users/LENOVO/keys/engqa-release.jks \
#     -alias engqa -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass <PASSWORD> -keypass <PASSWORD> \
#     -dname "CN=EngQA, OU=MOB, O=EngQA, L=HCM, C=VN"
#
# Then register its SHA-1 with Firebase:
#   keytool -list -v -keystore C:/Users/LENOVO/keys/engqa-release.jks -alias engqa
#   node tools/fix-google-signin.js <sha1-40-hex>

storeFile=C:/Users/LENOVO/keys/engqa-release.jks
storePassword=CHANGE_ME
keyAlias=engqa
keyPassword=CHANGE_ME
