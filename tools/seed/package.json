{
  "name": "engqa-seed",
  "version": "1.1.0",
  "private": true,
  "description": "Seeds EngQA Firestore with categories, sample users, questions, answers, votes and centres.",
  "main": "seed.js",
  "scripts": {
    "seed": "node seed.js",
    "seed:dry": "node seed.js --dry-run",
    "seed:clear": "node seed.js --clear",
    "seed:rest": "node seed-rest.js",
    "seed:rest:dry": "node seed-rest.js --dry-run",
    "seed:rest:clear": "node seed-rest.js --clear",
    "usernames:backfill": "node backfill-usernames.js --apply",
    "usernames:backfill:dry": "node backfill-usernames.js --dry-run",
    "reindex:search": "node reindex-search.js --apply",
    "reindex:search:dry": "node reindex-search.js --dry-run",
    "verify": "node verify.js"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0"
  }
}
